    (name: "duskberry_seeds", label: "Duskberry seeds", sprite: "item_seeds_duskberry", category: Seed),
    (name: "ashroot_seeds", label: "Ashroot seed tubers", sprite: "item_seeds_ashroot", category: Seed),
