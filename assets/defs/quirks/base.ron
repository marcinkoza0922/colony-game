// Personality quirks, rolled 2-3 per colonist. `stat_mods` apply while `when` holds.
[
    (name: "night_owl", label: "Night Owl", description: "Sleeps by day, works best at night.",
        sleep_shift: 6,
        stat_mods: [(stat: "work_speed", op: Mul(1.15), when: Night), (stat: "work_speed", op: Mul(0.9), when: Day)]),
    (name: "claustrophobic", label: "Claustrophobic", description: "Hates being under rock.",
        conflicts: ["tunnel_rat"]),
    (name: "tunnel_rat", label: "Tunnel Rat", description: "Loves digging and feels safe underground.",
        stat_mods: [(stat: "mining_speed", op: Mul(1.25))], aptitudes: [("mining", 1.3)]),
    (name: "workaholic", label: "Workaholic", description: "Works fast, rarely needs a break.",
        conflicts: ["lazy"],
        stat_mods: [(stat: "work_speed", op: Mul(1.15))], need_rates: [("recreation", 0.5)]),
    (name: "lazy", label: "Lazy", description: "Slow to work, quick to need a break.",
        stat_mods: [(stat: "work_speed", op: Mul(0.8))], need_rates: [("recreation", 1.5)]),
    (name: "glutton", label: "Glutton", description: "Always hungry.",
        need_rates: [("hunger", 1.5)]),
    (name: "green_thumb", label: "Green Thumb", description: "A natural with plants.",
        stat_mods: [(stat: "plant_speed", op: Mul(1.3))], aptitudes: [("botany", 1.5)]),
    (name: "clumsy", label: "Clumsy", description: "Drops things, trips, fumbles tools.",
        conflicts: ["nimble"],
        stat_mods: [(stat: "construction_speed", op: Mul(0.8)), (stat: "crafting_speed", op: Mul(0.8)), (stat: "move_speed", op: Mul(0.95)),
            (stat: "accident_chance", op: Mul(2.0))]),
    (name: "nimble", label: "Nimble", description: "Quick on their feet.",
        stat_mods: [(stat: "move_speed", op: Mul(1.15))]),
    (name: "perfectionist", label: "Perfectionist", description: "Slow, careful crafter who learns from every detail.",
        stat_mods: [(stat: "crafting_speed", op: Mul(0.8))], aptitudes: [("crafting", 1.4)]),
    (name: "iron_stomach", label: "Iron Stomach", description: "Eats anything without complaint.",
        stat_mods: [(stat: "food_poison_chance", op: Mul(0.0))]),
    (name: "light_sleeper", label: "Light Sleeper", description: "Never quite rested.",
        need_rates: [("rest", 1.25)]),
    (name: "optimist", label: "Optimist", description: "Sees the bright side of the apocalypse.",
        conflicts: ["pessimist"]),
    (name: "pessimist", label: "Pessimist", description: "Knows it will all end badly. Again."),
    (name: "loner", label: "Loner", description: "Prefers solitude.",
        conflicts: ["sociable"], chattiness: 0.4),
    (name: "sociable", label: "Sociable", description: "Thrives around others.", chattiness: 1.6),
    (name: "steady_nerves", label: "Steady Nerves", description: "Hard to rattle.",
        conflicts: ["volatile"],
        stat_mods: [(stat: "break_threshold", op: Add(-10.0))]),
    (name: "volatile", label: "Volatile", description: "Snaps easily.", fight_chance: 2.5,
        stat_mods: [(stat: "break_threshold", op: Add(10.0))]),
    (name: "sun_lover", label: "Sun Lover", description: "Happiest under open sky.",
        conflicts: ["tunnel_rat"]),
    (name: "quick_study", label: "Quick Study", description: "Picks up skills fast.",
        stat_mods: [(stat: "learn_rate", op: Mul(1.3))]),
    // ---- social
    (name: "bigot", label: "Bigot", description: "Distrusts other races, and takes ages to change their mind.",
        conflicts: ["open_minded"], race_bias: 2.5, weight: 0.6),
    (name: "open_minded", label: "Open-minded", description: "Judges people, not peoples.", race_bias: 0.0),
    (name: "abrasive", label: "Abrasive", description: "Says what they think. Loudly.",
        conflicts: ["kind"], fight_chance: 1.5),
    (name: "kind", label: "Kind", description: "Always has a good word for someone."),
    (name: "romantic", label: "Romantic", description: "Falls in love easily, and often."),
    (name: "tough", label: "Tough", description: "Shrugs off pain and heals fast.",
        stat_mods: [(stat: "injury_heal", op: Mul(1.3)), (stat: "immunity_gain", op: Mul(1.15))]),
    (name: "sickly", label: "Sickly", description: "Catches everything going around.", conflicts: ["tough"],
        stat_mods: [(stat: "immunity_gain", op: Mul(0.75))]),
]
